APP_NAME=Riset
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=riset
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Masuk dengan Google (console.cloud.google.com > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Pencarian referensi (gratis). Email kontak agar masuk "polite pool" Crossref/OpenAlex.
CROSSREF_MAILTO=
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# Opsional tapi disarankan: tanpa kunci, Semantic Scholar sering menolak (batas bersama).
SEMANTIC_SCHOLAR_API_KEY=

# Layanan AI OpenAI-compatible: POST {AI_BASE_URL}/chat/completions
# Contoh AI_BASE_URL: https://api.penyedia-anda.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=120
# Kirim response_format json_object. Set false bila API Anda menolak parameter itu.
AI_JSON_MODE=true

# Elsevier Scopus; institutional token opsional sesuai hak akses Elsevier.
SCOPUS_API_KEY=
SCOPUS_INSTTOKEN=
